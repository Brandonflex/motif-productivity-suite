{
  "name": "motif-productivity-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first productivity suite — tasks, projects and workspace analytics.",
  "engines": {
    "node": ">=20.19",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint:types": "npm run typecheck",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css && npm run check:tokens",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.22",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@blinkdotnew/ui": "^0.5.2",
    "@hookform/resolvers": "^5.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.400.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brandonflex/motif-productivity-suite.git"
  },
  "homepage": "https://motif-productivity-suite.vercel.app/",
  "bugs": {
    "url": "https://github.com/Brandonflex/motif-productivity-suite/issues"
  },
  "keywords": [
    "productivity",
    "tasks",
    "projects",
    "local-first",
    "react",
    "vite",
    "tailwind"
  ]
}
