# ─────────────────────────────────────────────────────────────
# Motif environment variables
#
# Copy this file to `.env.local` and fill in the values you need.
# Vite only exposes variables prefixed with `VITE_` to client code —
# never put secrets in them, everything here ships to the browser.
# ─────────────────────────────────────────────────────────────

# Canonical site origin used for canonical URLs, sitemap.xml and robots.txt
# at build time. Defaults to the production deployment when unset.
VITE_SITE_URL=https://motif-productivity-suite.vercel.app
